# User/plugin config — personal data, never commit
.claude-plugin-config.json
.claude/settings.local.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/

# Node / web tooling (for consumers running the lint packs)
node_modules/
dist/

# Secrets — never commit
*.env
.env.*
!.env.example
secrets.*
credentials.*

# benchmark: raw runs are committed deliberately (reproducibility);
# only ignore local scratch
benchmark/harness/.scratch/
